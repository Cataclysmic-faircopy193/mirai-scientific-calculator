        "@openmirai/calculator-core@^0.2.0",
        "lucide-react@^1.28.0"
      ],
      "registryDependencies": [
        "badge",
        "button",
        "card",
        "input",
        "scroll-area",
        "select",
        "separator",
        "switch",
        "tabs",
        "textarea",
        "tooltip"
      ],
      "files": [
        {
          "path": "../../packages/calculator-registry/src/components/mirai-calculator/mirai-calculator.tsx",
          "type": "registry:component",
