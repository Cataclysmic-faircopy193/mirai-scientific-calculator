{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "jsdoc-required",
      "specifier": "eslint-plugin-jsdoc"
    }
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "browser": true
  },
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "apps/web/src/route-tree.gen.ts",
    "pnpm-lock.yaml",
    "registry-dist",
    "release",
    "site-dist"
  ],
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "rules": {
    "arrow-body-style": "error",
    "curly": "error",
    "eqeqeq": [
      "warn",
      "always",
      {
        "null": "ignore"
      }
    ],
    "import/consistent-type-specifier-style": "error",
    "import/no-duplicates": "error",
    "import/newline-after-import": "error",
    "import/no-unassigned-import": "off",
    "jsx-a11y/control-has-associated-label": "warn",
    "jsx-a11y/heading-has-content": "warn",
    "jsx-a11y/interactive-supports-focus": "warn",
    "jsx-a11y/media-has-caption": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "no-console": "warn",
    "no-control-regex": "warn",
    "no-debugger": "error",
    "no-duplicate-imports": "off",
    "no-empty-pattern": "error",
    "no-extra-boolean-cast": "error",
    "no-implicit-coercion": [
      "warn",
      {
        "allow": ["!!"]
      }
    ],
    "no-multi-assign": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "no-unneeded-ternary": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": "error",
    "no-useless-return": "warn",
    "no-var": "error",
    "object-shorthand": "error",
    "oxc/only-used-in-recursion": "warn",
    "prefer-const": "error",
    "prefer-template": "error",
    "react/exhaustive-deps": "warn",
    "react/jsx-boolean-value": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-unstable-nested-components": "off",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "error",
    "typescript/array-type": [
      "error",
      {
        "default": "generic",
        "readonly": "generic"
      }
    ],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-duplicate-enum-values": "warn",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-empty-interface": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Boolean": "Use boolean instead.",
          "Function": "Use a specific function signature instead.",
          "Number": "Use number instead.",
          "Object": "Use object or a specific interface instead.",
          "String": "Use string instead."
        }
      }
    ],
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-useless-empty-export": "off",
    "typescript/prefer-as-const": "error",
    "typescript/triple-slash-reference": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-await-in-promise-methods": "warn",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-nested-ternary": "error",
    "unicorn/no-null": "off",
    "unicorn/require-module-specifiers": "off",
    "vitest/expect-expect": [
      "warn",
      {
        "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType"]
      }
    ],
    "vitest/no-conditional-expect": "warn",
    "vitest/no-conditional-tests": "warn",
    "vitest/no-focused-tests": "error",
    "vitest/require-mock-type-parameters": "off",
    "vitest/valid-title": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "jsdoc-required/check-alignment": "warn",
        "jsdoc-required/check-tag-names": "warn",
        "jsdoc-required/require-description": "warn",
        "jsdoc-required/require-jsdoc": [
          "warn",
          {
            "publicOnly": true,
            "require": {
              "ArrowFunctionExpression": true,
              "ClassDeclaration": true,
              "ClassExpression": true,
              "FunctionDeclaration": true,
              "FunctionExpression": true,
              "MethodDefinition": false
            }
          }
        ]
      }
    },
    {
      "files": ["**/*.config.*"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off",
        "unicorn/prefer-string-raw": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/no-useless-empty-export": "off",
        "typescript/triple-slash-reference": "off",
        "unicorn/require-module-specifiers": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*",
        "**/*.test.*",
        "**/test-setup.ts",
        "apps/web/src/test/**/*.ts"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["apps/web/src/components/ui/**/*.tsx"],
      "rules": {
        "jsdoc-required/require-jsdoc": "off",
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["apps/web/src/routes/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
