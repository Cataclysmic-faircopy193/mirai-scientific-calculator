    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.27.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
