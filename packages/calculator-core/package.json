{
  "name": "@openmirai/calculator-core",
  "version": "0.2.0",
  "description": "Framework-independent scientific calculator, graphing, statistics, and math tools.",
  "keywords": [
    "calculator",
    "graphing-calculator",
    "math-tools",
    "scientific-calculator",
    "statistics"
  ],
  "homepage": "https://github.com/openmirai/mirai-scientific-calculator#readme",
  "bugs": {
    "url": "https://github.com/openmirai/mirai-scientific-calculator/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmirai/mirai-scientific-calculator.git",
    "directory": "packages/calculator-core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/mirai-calculator/calculator-engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/mirai-calculator/calculator-engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    },
    "./graphing": {
      "import": {
        "types": "./dist/mirai-calculator/graphing.d.ts",
        "default": "./dist/graphing.js"
      },
      "require": {
        "types": "./dist/mirai-calculator/graphing.d.cts",
        "default": "./dist/graphing.cjs"
      }
    },
    "./statistics": {
      "import": {
        "types": "./dist/mirai-calculator/statistics.d.ts",
        "default": "./dist/statistics.js"
      },
      "require": {
        "types": "./dist/mirai-calculator/statistics.d.cts",
        "default": "./dist/statistics.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/mirai-calculator/tools.d.ts",
        "default": "./dist/tools.js"
      },
      "require": {
        "types": "./dist/mirai-calculator/tools.d.cts",
        "default": "./dist/tools.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -b && vite build && node ../../scripts/copy-cjs-types.mjs dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "publint": "publint",
    "prepack": "pnpm build && pnpm publint"
  },
  "dependencies": {},
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
